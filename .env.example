# Copy to .env and fill in from your Supabase project settings.
#
# These three are PUBLISHABLE by design: they ship inside the browser
# bundle, so anyone with the built site already has them. What protects
# the data is Row Level Security on every table, not the secrecy of
# these values.
#
# Never put a service_role key, an OpenAI key or any other secret in
# this file or in .env -- both are read by the client bundle. Server
# secrets belong in the edge function's own environment.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
