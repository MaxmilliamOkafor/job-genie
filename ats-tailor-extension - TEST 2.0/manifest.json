{
  "manifest_version": 3,
  "name": "ATS Tailor Enhanced v3.0 - Ultra-Fast Perfect CV",
  "version": "3.0.0",
  "description": "v3.0: Ultra-fast CV parser (<50ms) with 100% formatting preservation. Profile-only approach - no fallbacks. Enhanced keyword extraction (25+ keywords) and real-time match scoring.",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.workday.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.bullhornstaffing.com/*",
    "https://*.bullhorn.com/*",
    "https://*.teamtailor.com/*",
    "https://*.workable.com/*",
    "https://*.icims.com/*",
    "https://*.oracle.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.taleo.net/*",
    "https://wntpldomgjutwufphnpg.supabase.co/*",
    "https://cdnjs.cloudflare.com/*",
    "https://*.google.com/*",
    "https://*.meta.com/*",
    "https://*.amazon.com/*",
    "https://*.microsoft.com/*",
    "https://*.apple.com/*",
    "https://*.salesforce.com/*",
    "https://*.ibm.com/*",
    "https://*.adobe.com/*",
    "https://*.stripe.com/*",
    "https://*.hubspot.com/*",
    "https://*.intel.com/*",
    "https://*.servicenow.com/*",
    "https://*.paypal.com/*",
    "https://*.tiktok.com/*",
    "https://*.dropbox.com/*",
    "https://*.twilio.com/*",
    "https://*.datadoghq.com/*",
    "https://*.zendesk.com/*",
    "https://*.docusign.com/*",
    "https://*.fidelity.com/*",
    "https://*.sap.com/*",
    "https://*.morganstanley.com/*",
    "https://*.kpmg.com/*",
    "https://*.deloitte.com/*",
    "https://*.accenture.com/*",
    "https://*.pwc.com/*",
    "https://*.ey.com/*",
    "https://*.citadel.com/*",
    "https://*.janestreet.com/*",
    "https://*.twosigma.com/*",
    "https://*.bloomberg.com/*",
    "https://*.jpmorgan.com/*",
    "https://*.capitalone.com/*",
    "https://*.gitlab.com/*",
    "https://*.atlassian.com/*",
    "https://*.snap.com/*",
    "https://*.cisco.com/*",
    "https://www.metacareers.com/*",
    "https://explore.jobs.netflix.net/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://*.jazzhr.com/*"
  ],
  
  "action": {
    "default_popup": "enhanced-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.workday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.bullhornstaffing.com/*",
        "https://*.bullhorn.com/*",
        "https://*.teamtailor.com/*",
        "https://*.workable.com/*",
        "https://*.icims.com/*",
        "https://*.oracle.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.taleo.net/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.jazzhr.com/*",
        "https://www.metacareers.com/*",
        "https://explore.jobs.netflix.net/*"
      ],
      "js": [
        "ENHANCED_CV_PARSER.js",
        "ENHANCED_CONTENT.js"
      ],
      "css": ["enhanced-content.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "service_worker": "ENHANCED_BACKGROUND.js"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "enhanced-content.css",
        "ENHANCED_CV_PARSER.js",
        "ENHANCED_CONTENT.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
